{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node scripts/claude-hooks/session-context.mjs",
            "timeout": 10
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|MultiEdit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "node scripts/claude-hooks/twin-file-warn.mjs",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
