# Read-only CUPS job discovery. Never add Print-Job or other mutations here.
{
  NAME "CLC local job reconciliation"
  OPERATION Get-Jobs
  GROUP operation-attributes-tag
  ATTR charset attributes-charset utf-8
  ATTR language attributes-natural-language en
  ATTR uri printer-uri $uri
  ATTR name requesting-user-name $clc_user
  ATTR keyword which-jobs all
  ATTR keyword requested-attributes job-id,job-name,job-state,job-printer-uri
  STATUS successful-ok
}
