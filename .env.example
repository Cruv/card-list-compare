# Copy to .env and fill in for a fresh installation. Existing installations must
# reuse their current credentials, data directory and Compose project identity.
# .env is gitignored — never commit real secrets.

# Compose deployment settings. Defaults use the CI-published GHCR image.
# Pin CLC_IMAGE to a verified registry digest/SHA tag when selecting an exact build.
# CLC_IMAGE=ghcr.io/cruv/card-list-compare:latest
# Set an EXISTING ABSOLUTE path in Portainer; a Git checkout's ./data is not your
# existing application directory. Missing bind directories fail instead of being created.
# CLC_DATA_DIR=/absolute/path/to/existing/clc-data
# Preserve an existing container name, host port, UID/GID and timezone on adoption.
# CLC_CONTAINER_NAME=card-list-compare
# CLC_PORT=8080
# PUID=1000
# PGID=1000
# TZ=America/New_York

# REQUIRED. Signs auth tokens. Must be strong and unique — a weak/default value
# lets anyone forge admin tokens, so the server refuses to start without one.
# Generate one for a NEW installation only; preserve the configured value on updates:
#   openssl rand -hex 32
JWT_SECRET=

# Path to the SQLite database file.
# Default: ./server/data/cardlistcompare.db in dev, /app/data/cardlistcompare.db in Docker.
# DB_PATH=./server/data/cardlistcompare.db

# Express backend port (default 3001; nginx serves port 80 in Docker).
# PORT=3001

# PDF generation checks the latest Silhouette Card Maker main branch at startup.
# Source, Python environment and wheels persist beside the database under
# silhouette-card-maker/. A failed update keeps the last compatible version.
# Set false to disable startup preparation and PDF generation on this instance.
PRINT_ENABLED=true
# Development only: path to a Python with venv/pip; Docker supplies its runtime.
# PRINT_PYTHON=python3

# Optional household print station. Generate a SEPARATE random credential with
# openssl rand -hex 32 for a NEW station; use the same value in the Mac token file.
# Never use the JWT secret here. Blank disables physical queue requests.
PRINT_STATION_TOKEN=
# Administrators can queue by default. Add household user IDs separated by commas.
PRINT_ALLOWED_USER_IDS=
# Retained print-job disk quota in MiB (default 10 GiB; includes staged images).
PRINT_STORAGE_MAX_MB=10240

# Public URL of the app — used to build links in password-reset emails.
# APP_URL=http://localhost:8080

# Optional. SMTP for password-reset and notification emails. Leave blank to
# disable email (reset links / deck-change alerts will be unavailable).
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_USER=your-email@example.com
# SMTP_PASS=your-app-password
# SMTP_FROM=CardListCompare <no-reply@example.com>

# Optional ManaSync bridge. User tokens are entered in CLC Settings, not here.
# Enter the server-reachable ManaSync URL in CLC Settings. Custom domains, ports,
# and reverse-proxy paths work without an environment allowlist.
# Optional base64 32-byte encryption key, separate from JWT and ManaSync secrets.
# If omitted, CLC persists .manasync-bridge-key beside DB_PATH; back it up too.
# Generate a managed key with: openssl rand -base64 32
# MANASYNC_BRIDGE_KEY=
